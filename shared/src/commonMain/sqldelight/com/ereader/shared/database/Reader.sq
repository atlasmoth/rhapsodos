CREATE TABLE document (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    file_path TEXT NOT NULL,
    source_revision TEXT NOT NULL,
    page_count INTEGER NOT NULL,
    extraction_status TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE passage (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES document(id),
    ordinal INTEGER NOT NULL,
    page_index INTEGER NOT NULL,
    page_start INTEGER NOT NULL,
    page_end INTEGER NOT NULL,
    source_start INTEGER NOT NULL,
    source_end INTEGER NOT NULL,
    source_text TEXT NOT NULL,
    spoken_text TEXT NOT NULL,
    UNIQUE(document_id, ordinal)
);

CREATE TABLE source_page (
    document_id TEXT NOT NULL REFERENCES document(id),
    page_index INTEGER NOT NULL,
    source_text TEXT NOT NULL,
    provenance TEXT NOT NULL DEFAULT 'embedded',
    language_tag TEXT NOT NULL DEFAULT 'en',
    regions_json TEXT NOT NULL DEFAULT '[]',
    geometry_space TEXT NOT NULL DEFAULT 'unspecified',
    PRIMARY KEY(document_id, page_index)
);

CREATE TABLE note (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES document(id),
    passage_id TEXT NOT NULL REFERENCES passage(id),
    source_revision TEXT NOT NULL,
    page_index INTEGER NOT NULL,
    source_start INTEGER NOT NULL,
    source_end INTEGER NOT NULL,
    quote TEXT NOT NULL,
    recording_path TEXT NOT NULL,
    duration_millis INTEGER NOT NULL,
    offset_millis INTEGER NOT NULL,
    status TEXT NOT NULL,
    machine_transcript TEXT NOT NULL,
    edited_transcript TEXT,
    transcript_revision INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE playback_position (
    document_id TEXT NOT NULL PRIMARY KEY REFERENCES document(id),
    passage_id TEXT NOT NULL REFERENCES passage(id),
    offset_millis INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    passage_fraction REAL NOT NULL DEFAULT 0
);

CREATE TABLE bookmark (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES document(id),
    passage_id TEXT NOT NULL UNIQUE REFERENCES passage(id),
    label TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE model_install (
    pack_id TEXT NOT NULL PRIMARY KEY,
    generation TEXT NOT NULL,
    status TEXT NOT NULL,
    bytes_downloaded INTEGER NOT NULL,
    total_bytes INTEGER NOT NULL,
    installed_path TEXT NOT NULL,
    error TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE file_removal (
    path TEXT NOT NULL PRIMARY KEY
);

CREATE TABLE document_section (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES document(id),
    title TEXT NOT NULL,
    passage_id TEXT NOT NULL REFERENCES passage(id),
    page_index INTEGER NOT NULL,
    ordinal INTEGER NOT NULL
);

CREATE TABLE pronunciation_rule (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES document(id),
    term TEXT NOT NULL,
    replacement TEXT NOT NULL,
    language_tag TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE(document_id, term)
);

CREATE TABLE narration_revision (
    document_id TEXT NOT NULL PRIMARY KEY REFERENCES document(id),
    revision INTEGER NOT NULL
);

allDocuments:
SELECT document.*, (SELECT COUNT(*) FROM passage WHERE document_id = document.id) AS passage_count
FROM document ORDER BY created_at DESC;

documentById:
SELECT document.*, (SELECT COUNT(*) FROM passage WHERE document_id = document.id) AS passage_count
FROM document WHERE id = ?;

insertDocument:
INSERT INTO document(id, title, file_path, source_revision, page_count, extraction_status, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertPassage:
INSERT INTO passage VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSourcePage:
INSERT INTO source_page VALUES (?, ?, ?, ?, ?, ?, ?);

pagesForDocument:
SELECT * FROM source_page WHERE document_id = ? ORDER BY page_index;

sourcePageByIndex:
SELECT * FROM source_page WHERE document_id = ? AND page_index = ?;

updatePageGeometry:
UPDATE source_page SET regions_json = ?, geometry_space = ? WHERE document_id = ? AND page_index = ?;

passagesForDocument:
SELECT * FROM passage WHERE document_id = ? ORDER BY ordinal;

passageById:
SELECT * FROM passage WHERE id = ?;

allNotes:
SELECT * FROM note ORDER BY created_at DESC;

noteById:
SELECT * FROM note WHERE id = ?;

insertNote:
INSERT INTO note VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

commitNote:
UPDATE note SET recording_path = ?, duration_millis = ?, status = 'pending' WHERE id = ? AND status IN ('draft', 'interrupted') AND duration_millis = 0;

markNoteStatus:
UPDATE note SET status = ? WHERE id = ?;

updateTranscript:
UPDATE note SET machine_transcript = ?, status = ? WHERE id = ? AND recording_path = ?;

editTranscript:
UPDATE note SET edited_transcript = ?, transcript_revision = transcript_revision + 1 WHERE id = ?;

discardDraft:
DELETE FROM note WHERE id = ? AND status IN ('draft', 'interrupted') AND duration_millis = 0;

allPositions:
SELECT * FROM playback_position;

positionForDocument:
SELECT * FROM playback_position WHERE document_id = ?;

lastPassageEnd:
SELECT source_end FROM passage WHERE document_id = ? ORDER BY ordinal DESC LIMIT 1;

savePosition:
INSERT OR REPLACE INTO playback_position(document_id, passage_id, offset_millis, updated_at, passage_fraction)
VALUES (?, ?, ?, ?, ?);

allBookmarks:
SELECT * FROM bookmark ORDER BY created_at DESC;

bookmarksForDocument:
SELECT * FROM bookmark WHERE document_id = ? ORDER BY created_at DESC;

bookmarkForPassage:
SELECT * FROM bookmark WHERE passage_id = ?;

insertBookmark:
INSERT INTO bookmark VALUES (?, ?, ?, ?, ?);

deleteBookmark:
DELETE FROM bookmark WHERE id = ?;

renameDocument:
UPDATE document SET title = ? WHERE id = ?;

setDocumentExtractionStatus:
UPDATE document SET extraction_status = ? WHERE id = ?;

deleteDocumentNotes:
DELETE FROM note WHERE document_id = ?;

deleteDocumentBookmarks:
DELETE FROM bookmark WHERE document_id = ?;

deleteDocumentPosition:
DELETE FROM playback_position WHERE document_id = ?;

deleteDocumentPassages:
DELETE FROM passage WHERE document_id = ?;

deleteDocumentPages:
DELETE FROM source_page WHERE document_id = ?;

deleteDocument:
DELETE FROM document WHERE id = ?;

deleteNote:
DELETE FROM note WHERE id = ?;

enqueueFileRemoval:
INSERT OR IGNORE INTO file_removal VALUES (?);

pendingFileRemovals:
SELECT * FROM file_removal;

acknowledgeFileRemoval:
DELETE FROM file_removal WHERE path = ?;

allModelInstalls:
SELECT * FROM model_install;

modelInstallById:
SELECT * FROM model_install WHERE pack_id = ?;

saveModelInstall:
INSERT OR REPLACE INTO model_install VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteModelInstall:
DELETE FROM model_install WHERE pack_id = ?;

searchPassages:
SELECT passage.*, document.title FROM passage JOIN document ON passage.document_id = document.id
WHERE (:documentId = '' OR passage.document_id = :documentId) AND instr(lower(source_text), lower(:query)) > 0
ORDER BY document.created_at DESC, passage.ordinal LIMIT 100;

searchNotes:
SELECT note.*, document.title FROM note JOIN document ON note.document_id = document.id
WHERE (:documentId = '' OR note.document_id = :documentId)
AND instr(lower(coalesce(edited_transcript, machine_transcript)), lower(:query)) > 0
ORDER BY note.created_at DESC LIMIT 100;

sectionsForDocument:
SELECT * FROM document_section WHERE document_id = ? ORDER BY ordinal;

insertSection:
INSERT INTO document_section VALUES (?, ?, ?, ?, ?, ?);

deleteDocumentSections:
DELETE FROM document_section WHERE document_id = ?;

pronunciationsForDocument:
SELECT * FROM pronunciation_rule WHERE document_id = ? ORDER BY updated_at DESC;

pronunciationById:
SELECT * FROM pronunciation_rule WHERE id = ?;

savePronunciation:
INSERT OR REPLACE INTO pronunciation_rule VALUES (?, ?, ?, ?, ?, ?);

deletePronunciation:
DELETE FROM pronunciation_rule WHERE id = ?;

deleteDocumentPronunciations:
DELETE FROM pronunciation_rule WHERE document_id = ?;

revisionForDocument:
SELECT revision FROM narration_revision WHERE document_id = ?;

saveNarrationRevision:
INSERT OR REPLACE INTO narration_revision VALUES (?, ?);

deleteDocumentNarrationRevision:
DELETE FROM narration_revision WHERE document_id = ?;
